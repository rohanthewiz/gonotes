.idea/
.vscode/
.zed/
# Claude Code: keep local settings out, but share the project's skills.
# The rule has to exclude .claude's *contents* rather than the directory
# itself — git won't re-include a path whose parent directory is excluded,
# so a plain ".claude" would make the negation below a no-op.
.claude/*
!.claude/skills/

.DS_Store
test/
test_db/

*.gob
*.csv
*.zip

*.sqlite
*.ddb
*.bytdb
data/

.env

# Leading slash anchors these to the repo root: unanchored, "gonotes" matches
# any path component of that name and would swallow directories like
# .claude/skills/gonotes/ along with the built binary.
/gonotes.exe
/gonotes
models.test

# Where cats-plugin.toml's build step puts its binary. Anchored for the same
# reason as the two above.
/bin/

# migration tool binary
gonotes-migrate

# cats' per-repo todo state. It is written by the cats host as you work, so
# tracking it means every session ends with an unrelated diff to carry.
.cats-todo/
